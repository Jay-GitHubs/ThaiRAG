# Live smoke suite targets. Copy to `.env.live` (gitignored) and fill in the
# URLs of the deployment YOU are testing. Never commit real hostnames or keys.
LIVE_ADMIN_URL=https://admin.example.com
LIVE_CHAT_URL=https://chat.example.com
LIVE_API_URL=https://api.example.com

# Optional: a static /v1 API key — enables the authenticated completions test.
# LIVE_API_KEY=sk-your-test-key
